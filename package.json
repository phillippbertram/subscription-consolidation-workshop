{
  "name": "premiumpass",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.19.0",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "dev": "pnpm --filter @premiumpass/bff dev",
    "mobile:dev": "pnpm --filter @premiumpass/mobile dev",
    "mobile:ios": "pnpm --filter @premiumpass/mobile ios",
    "start": "pnpm --filter @premiumpass/bff start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,yaml,yml}\"",
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "synth": "pnpm --filter @premiumpass/infra synth",
    "deploy:dev": "pnpm --filter @premiumpass/infra run deploy",
    "bootstrap:dev": "pnpm --filter @premiumpass/infra run bootstrap",
    "db:up": "docker compose up -d dynamodb && pnpm --filter @premiumpass/bff run db:init",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs --tail=100 dynamodb",
    "demo:subscription": "pnpm --filter @premiumpass/bff run demo:subscription"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.1"
  }
}

{
  "name": "premiumpass",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.19.0",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "dev": "pnpm local:up && concurrently --kill-others --kill-timeout 15000 --names api,webhook,apple,worker,web \"pnpm dev:api\" \"pnpm dev:webhook\" \"pnpm dev:apple-webhook\" \"pnpm dev:worker\" \"pnpm web:dev\"",
    "dev:api": "pnpm --filter @premiumpass/bff run dev",
    "dev:api:lan": "HOST=0.0.0.0 pnpm dev:api",
    "start": "pnpm --filter @premiumpass/bff run start",
    "web:dev": "pnpm --filter @premiumpass/web run dev",
    "mobile:dev": "pnpm --filter @premiumpass/mobile run dev",
    "mobile:dev:lan": "pnpm --filter @premiumpass/mobile run dev:lan",
    "mobile:ios": "pnpm --filter @premiumpass/mobile run ios",
    "local:up": "docker compose up -d && pnpm --filter @premiumpass/bff run db:init",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs --tail=100",
    "demo:subscription": "pnpm --filter @premiumpass/subscription-worker run demo:subscription",
    "stripe:listen": "pnpm --filter @premiumpass/stripe-webhook run stripe:listen",
    "synth": "pnpm --filter @premiumpass/infra run synth",
    "deploy:dev": "pnpm --filter @premiumpass/infra run deploy",
    "bootstrap:dev": "pnpm --filter @premiumpass/infra run bootstrap",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,yaml,yml}\"",
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "dev:webhook": "pnpm --filter @premiumpass/stripe-webhook run dev",
    "dev:worker": "pnpm --filter @premiumpass/subscription-worker run dev",
    "dev:apple-webhook": "pnpm --filter @premiumpass/apple-webhook run dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.1",
    "concurrently": "10.0.6"
  }
}

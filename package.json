{
  "name": "premiumpass",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.19.0",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "dev": "pnpm local:up && concurrently --kill-others --kill-timeout 15000 --names api,webhook,worker,web \"pnpm dev:api\" \"pnpm dev:webhook\" \"pnpm dev:worker\" \"pnpm web:dev\"",
    "dev:api": "pnpm -C services/bff dev",
    "start": "pnpm -C services/bff start",
    "web:dev": "pnpm -C apps/web dev",
    "mobile:dev": "pnpm -C apps/mobile dev",
    "mobile:ios": "pnpm -C apps/mobile ios",
    "local:up": "docker compose up -d && pnpm -C services/bff db:init",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs --tail=100",
    "demo:subscription": "pnpm -C services/subscription-worker demo:subscription",
    "stripe:listen": "pnpm -C services/stripe-webhook stripe:listen",
    "synth": "pnpm -C infra synth",
    "deploy:dev": "pnpm -C infra run deploy",
    "bootstrap:dev": "pnpm -C infra run bootstrap",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,yaml,yml}\"",
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "dev:webhook": "pnpm -C services/stripe-webhook dev",
    "dev:worker": "pnpm -C services/subscription-worker dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.1",
    "concurrently": "10.0.6"
  }
}

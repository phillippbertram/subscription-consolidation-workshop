{
  "name": "premiumpass",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.19.0",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "dev": "pnpm config:sync && pnpm local:up && concurrently --kill-others --kill-timeout 15000 --names api,stripe-webhook,apple-webhook,google-webhook,subscription-worker,web-app,reconciliation \"pnpm dev:api\" \"pnpm dev:webhook:stripe\" \"pnpm dev:webhook:apple\" \"pnpm dev:webhook:google\" \"pnpm dev:worker\" \"pnpm dev:web\" \"pnpm cli reconcile --watch\"",
    "dev:api": "pnpm --filter @premiumpass/api run dev",
    "dev:api:lan": "HOST=0.0.0.0 pnpm dev:api",
    "dev:web": "pnpm --filter @premiumpass/web run dev",
    "dev:mobile": "pnpm config:sync && pnpm --filter @premiumpass/mobile run dev",
    "dev:mobile:lan": "pnpm config:sync && pnpm --filter @premiumpass/mobile run dev:lan",
    "dev:webhook:stripe": "pnpm --filter @premiumpass/stripe-webhook run dev",
    "dev:webhook:apple": "pnpm --filter @premiumpass/apple-webhook run dev",
    "dev:webhook:google": "pnpm --filter @premiumpass/google-webhook run dev",
    "dev:worker": "pnpm --filter @premiumpass/subscription-worker run dev",
    "dev:outbox": "pnpm --filter @premiumpass/outbox-publisher run dev",
    "dev:events": "pnpm --filter @premiumpass/outbox-publisher run consume",
    "docs:dev": "pnpm --filter @premiumpass/docs run dev",
    "docs:build": "pnpm --filter @premiumpass/docs run build",
    "docs:preview": "pnpm --filter @premiumpass/docs run preview",
    "local:up": "docker compose up -d && pnpm --filter @premiumpass/api run db:init",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs --tail=100",
    "mobile:ios": "pnpm config:sync && pnpm --filter @premiumpass/mobile run ios",
    "mobile:android": "pnpm config:sync && pnpm --filter @premiumpass/mobile run android",
    "mobile:android:doctor": "pnpm config:sync && pnpm --filter @premiumpass/mobile run android:doctor",
    "mobile:android:aab": "pnpm config:sync && pnpm --filter @premiumpass/mobile run android:aab",
    "outbox:publish": "pnpm --filter @premiumpass/outbox-publisher run publish",
    "stripe:listen": "pnpm --filter @premiumpass/stripe-webhook run stripe:listen",
    "webhooks:listen": "node scripts/webhooks-listen.mjs",
    "infra:synth": "pnpm --filter @premiumpass/infra run synth",
    "infra:bootstrap:dev": "pnpm config:sync && pnpm --filter @premiumpass/infra run bootstrap",
    "infra:deploy:dev": "pnpm config:sync && pnpm --filter @premiumpass/infra run deploy",
    "config:sync": "node scripts/config.mjs sync",
    "config:check": "node scripts/config.mjs check",
    "config:import": "node scripts/config.mjs import",
    "start:api": "pnpm --filter @premiumpass/api run start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "pnpm lint:fix && prettier --write \"**/*.{ts,tsx,js,mjs,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,yaml,yml}\"",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "cli": "pnpm --filter @premiumpass/cli run dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.1"
  }
}

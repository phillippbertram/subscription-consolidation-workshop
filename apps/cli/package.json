{
  "name": "@premiumpass/cli",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run clean && esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outdir=dist --entry-names='[name]' --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1149.0",
    "@aws-sdk/lib-dynamodb": "3.1149.0",
    "@premiumpass/aws-clients": "workspace:*",
    "@premiumpass/persistence": "workspace:*",
    "@premiumpass/domain": "workspace:*",
    "@premiumpass/billing-contracts": "workspace:*",
    "@premiumpass/logging": "workspace:*",
    "@premiumpass/apple-store": "workspace:*",
    "@premiumpass/google-play": "workspace:*",
    "stripe": "23.0.0",
    "zod": "4.6.5",
    "commander": "15.0.0",
    "@clack/prompts": "1.8.1",
    "@premiumpass/subscription-processing": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}

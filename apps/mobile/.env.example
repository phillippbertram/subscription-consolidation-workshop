# Public configuration only. Never add a client secret or access token.
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.eu.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-native-client-id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.premiumpass.example
# iOS Simulator reaches the Mac through loopback.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

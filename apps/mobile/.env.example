# Public configuration only. Never add a client secret or access token.
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.eu.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-native-client-id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.premiumpass.example
# iOS Simulator reaches the Mac through loopback.
# For an iPhone, use the Mac's private IPv4 or .local hostname, for example
# http://192.168.178.42:3000 or http://your-mac.local:3000, with pnpm dev:api:lan.
# A reachable LAN URL also works in the simulator. Keep the same port as PORT.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
# Optional native build setting: match the bundle identifier used for Xcode signing.
# Auth0 callback/logout URLs must include this identifier in lowercase.
# IOS_BUNDLE_IDENTIFIER=com.example.premiumpass

{
  "name": "@premiumpass/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client --localhost",
    "dev:lan": "expo start --dev-client --lan",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --no-install --no-clean",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform all",
    "android": "node --env-file-if-exists=.env scripts/android-build.mjs --dev",
    "prebuild:android": "expo prebuild --platform android --no-install --no-clean",
    "android:aab": "node --env-file-if-exists=.env scripts/android-build.mjs",
    "android:doctor": "node --env-file-if-exists=.env scripts/android-build.mjs --check"
  },
  "dependencies": {
    "@gluestack-ui/core": "5.0.15",
    "@gluestack-ui/utils": "5.0.6",
    "@premiumpass/api-contracts": "workspace:*",
    "@tanstack/react-query": "5.104.2",
    "axios": "1.20.0",
    "expo": "57.0.27",
    "expo-dev-client": "57.0.19",
    "expo-iap": "6.0.1",
    "expo-network": "57.0.2",
    "jwt-decode": "4.0.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-auth0": "5.11.1",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "19.2.4",
    "babel-preset-expo": "57.0.14",
    "react-dom": "19.2.3",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3"
  }
}

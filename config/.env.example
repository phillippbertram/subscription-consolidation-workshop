# PremiumPass configuration: the single place to edit settings.
#
# Copy this file to config/.env (ignored by Git), fill in your values, and run
# `pnpm config:sync`. It writes the .env file of every app and service, each
# with only the settings that program needs (see config/targets.mjs).
# `pnpm dev` and the mobile and deploy scripts sync first on their own.
# Never edit the generated .env files: the next sync would refuse or overwrite.
#
# Use synthetic data and test credentials only. Commented lines are optional;
# an unset or empty value is simply left out of the generated files.

# ---------------------------------------------------------------------------
# Auth0: one tenant for Web, Mobile, API, and AWS
# ---------------------------------------------------------------------------
# Bare tenant or custom domain, without https:// or a path. The API and AWS
# receive it as the issuer https://<domain>/.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
# Auth0 Custom API identifier; never a Native or SPA client ID.
AUTH0_AUDIENCE=https://api.premiumpass.example
# Public client IDs of the two Auth0 applications. Never add a client secret.
WEB_AUTH0_CLIENT_ID=your-spa-client-id
MOBILE_AUTH0_CLIENT_ID=your-native-client-id

# ---------------------------------------------------------------------------
# Local addresses
# ---------------------------------------------------------------------------
# Local API server only; Lambda needs neither port nor host. Loopback by
# default; `pnpm dev:api:lan` overrides the host for physical devices.
API_PORT=3000
API_HOST=127.0.0.1
# Website origin for checkout redirects (no trailing slash).
WEB_ORIGIN=http://localhost:5173
# How the website reaches the API.
WEB_API_URL=http://127.0.0.1:3000
# How the mobile app reaches the API. The iOS Simulator reaches the Mac through
# loopback, the Android Emulator through http://10.0.2.2:3000. A physical phone
# needs the Mac's private IPv4 or .local name, for example
# http://192.168.178.42:3000, together with `pnpm dev:api:lan`.
MOBILE_API_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug adds bounded body previews and error details to the local API log.
API_LOG_LEVEL=debug
# Webhooks and the worker.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Local infrastructure from Docker Compose
# ---------------------------------------------------------------------------
DYNAMODB_TABLE_NAME=premiumpass-local
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
SUBSCRIPTION_QUEUE_URL=http://127.0.0.1:9324/000000000000/premiumpass-subscriptions

# ---------------------------------------------------------------------------
# Stripe test mode
# ---------------------------------------------------------------------------
# Test keys only (sk_test_ or rk_test_). API, worker, and CLI receive it.
# STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# The product defines access; the lookup keys select the current offer for new
# purchases. The worker and CLI get no lookup key, because existing
# subscriptions may use older, archived prices.
# STRIPE_PRODUCT_ID=prod_REPLACE_ME
# STRIPE_MONTHLY_PRICE_LOOKUP_KEY=premium_monthly
# STRIPE_DAILY_PRICE_LOOKUP_KEY=premium_daily
# Printed by `pnpm webhooks:listen` (or `pnpm stripe:listen`); different from a
# Dashboard endpoint secret. Only the Stripe webhook receives it.
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ---------------------------------------------------------------------------
# Apple App Store Sandbox
# ---------------------------------------------------------------------------
# Enable after configuring the matching sandbox app and the local worker.
APPLE_ENABLED=false
# Also the iOS app's bundle identifier: purchases only verify when both match.
# Auth0 callback and logout URLs contain it in lowercase.
APPLE_BUNDLE_ID=com.example.premiumpass
APPLE_PRODUCT_ID=premiumpass.premium.monthly.v2
# In-App Purchase key. Only the worker and the CLI receive these; no ingress
# needs the private key. Use an absolute path.
# APPLE_IAP_KEY_ID=YOUR_KEY_ID
# APPLE_IAP_ISSUER_ID=YOUR_ISSUER_UUID
# APPLE_IAP_PRIVATE_KEY_PATH=/absolute/path/SubscriptionKey_YOUR_KEY_ID.p8

# ---------------------------------------------------------------------------
# Google Play license tests
# ---------------------------------------------------------------------------
# Keep disabled until the Play Console setup is done (docs/GOOGLE_PLAY.md).
GOOGLE_PLAY_ENABLED=false
# Also the Android app's package name. Choose it before the first Play upload;
# it cannot change later.
# GOOGLE_PLAY_PACKAGE_NAME=com.yourcompany.premiumpass
# GOOGLE_PLAY_PRODUCT_ID=premium_monthly
# GOOGLE_PLAY_BASE_PLAN_ID=monthly
# Backend service-account JSON key; only the worker and the CLI receive it.
# GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/absolute/private/path/google.service-account.json
# Authenticated Pub/Sub push to the local receiver. The subscription is the
# full name projects/<project-id>/subscriptions/<subscription-id>.
# GOOGLE_PLAY_PUSH_AUDIENCE=https://your-tunnel.example/v1/webhooks/google
# GOOGLE_PLAY_PUSH_SERVICE_ACCOUNT_EMAIL=premiumpass-play-push@your-project.iam.gserviceaccount.com
# GOOGLE_PLAY_PUSH_SUBSCRIPTION=projects/your-project/subscriptions/premiumpass-play-push

# ---------------------------------------------------------------------------
# Mobile native builds
# ---------------------------------------------------------------------------
# Increase for every Play upload.
# ANDROID_VERSION_CODE=1
# Signed AAB upload; backend Google credentials never belong here.
# ANDROID_UPLOAD_KEYSTORE_FILE=/absolute/private/path/premiumpass-upload.jks
# ANDROID_UPLOAD_KEYSTORE_PASSWORD=your-upload-store-password
# ANDROID_UPLOAD_KEY_ALIAS=premiumpass-upload
# ANDROID_UPLOAD_KEY_PASSWORD=your-upload-key-password

# ---------------------------------------------------------------------------
# AWS deployment: only infra/.env receives these
# ---------------------------------------------------------------------------
# The Auth0 settings and the Apple and Google IDs above are shared with AWS.
# Settings that differ in the cloud have a CLOUD_ prefix.
# AWS_PROFILE=premiumpass-dev
# AWS_REGION=eu-central-1
# AWS_ACCOUNT_ID=YOUR_12_DIGIT_ACCOUNT_ID
# Existing Secrets Manager ARNs only; secret values are never passed to CDK.
# STRIPE_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:YOUR_12_DIGIT_ACCOUNT_ID:secret:premiumpass/stripe-test-REPLACE
# CLOUD_APPLE_ENABLED=false
# APPLE_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:YOUR_12_DIGIT_ACCOUNT_ID:secret:premiumpass/apple-sandbox-REPLACE
# CLOUD_GOOGLE_PLAY_ENABLED=false
# GOOGLE_PLAY_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:YOUR_12_DIGIT_ACCOUNT_ID:secret:premiumpass/google-play-test-REPLACE
# A stable audience identifier; set the same audience on the cloud Pub/Sub
# subscription, whose endpoint is the GoogleWebhookUrl deploy output.
# CLOUD_GOOGLE_PLAY_PUSH_AUDIENCE=https://billing.example.com/google-play-push
# CLOUD_GOOGLE_PLAY_PUSH_SUBSCRIPTION=projects/your-project/subscriptions/premiumpass-play-push-aws
# One shared five-minute schedule; each discovery target is separately opt-in.
# Apple and Google reconciliation also require the provider to be enabled.
# RECONCILIATION_STRIPE_ENABLED=false
# RECONCILIATION_APPLE_ENABLED=false
# RECONCILIATION_GOOGLE_ENABLED=false

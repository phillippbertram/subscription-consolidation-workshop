# Public deployment configuration. Copy to infra/.env and replace placeholders.
# Existing shell environment variables take precedence over this file.
AWS_PROFILE=premiumpass-dev
AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=YOUR_12_DIGIT_ACCOUNT_ID

# Required for deploy:dev; bootstrap:dev needs only the AWS values above.
AUTH0_ISSUER=https://your-tenant.eu.auth0.com/
AUTH0_AUDIENCE=https://api.premiumpass.example

# Existing secret ARN only; values are never passed to CDK. Required for deploy.
STRIPE_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:YOUR_12_DIGIT_ACCOUNT_ID:secret:premiumpass/stripe-test-REPLACE

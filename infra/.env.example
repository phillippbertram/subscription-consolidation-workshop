# Public deployment configuration. Copy to infra/.env and replace placeholders.
# Existing shell environment variables take precedence over this file.
AWS_PROFILE=premiumpass-dev
AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=YOUR_12_DIGIT_ACCOUNT_ID

# Required for infra:deploy:dev; infra:bootstrap:dev needs only the AWS values above.
AUTH0_ISSUER=https://your-tenant.eu.auth0.com/
AUTH0_AUDIENCE=https://api.premiumpass.example

# Existing secret ARN only; values are never passed to CDK. Required for deploy.
STRIPE_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:YOUR_12_DIGIT_ACCOUNT_ID:secret:premiumpass/stripe-test-REPLACE

# Optional Apple Sandbox notification processing. Only the worker reads this secret.
APPLE_ENABLED=false
APPLE_BUNDLE_ID=com.example.premiumpass
APPLE_PRODUCT_ID=premiumpass.premium.monthly.v2
APPLE_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:YOUR_12_DIGIT_ACCOUNT_ID:secret:premiumpass/apple-sandbox-REPLACE

# Optional Google Play license-test API and notifications.
# The ingress uses public-key verification; only the worker reads this secret.
GOOGLE_PLAY_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.example.premiumpass
GOOGLE_PLAY_PRODUCT_ID=premium_monthly
GOOGLE_PLAY_BASE_PLAN_ID=monthly
GOOGLE_PLAY_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:YOUR_12_DIGIT_ACCOUNT_ID:secret:premiumpass/google-play-test-REPLACE
# Stable audience identifier; configure the same audience in Pub/Sub.
GOOGLE_PLAY_PUSH_AUDIENCE=https://billing.example.com/google-play-push
GOOGLE_PLAY_PUSH_SERVICE_ACCOUNT_EMAIL=push@your-project.iam.gserviceaccount.com
GOOGLE_PLAY_PUSH_SUBSCRIPTION=projects/your-project/subscriptions/premiumpass-play-push

# One shared five-minute schedule; each discovery target is separately opt-in.
# Apple/Google reconciliation additionally requires the corresponding provider above.
RECONCILIATION_STRIPE_ENABLED=false
RECONCILIATION_APPLE_ENABLED=false
RECONCILIATION_GOOGLE_ENABLED=false

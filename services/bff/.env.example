# Local HTTP server only; Lambda does not need PORT or HOST.
PORT=3000
# Loopback by default. Use pnpm dev:api:lan for physical-device access.
HOST=127.0.0.1
# debug includes bounded JSON/text body previews and server error details.
# Local default: debug. Lambda default: info.
LOG_LEVEL=debug

# Public configuration. Use the exact tenant/custom-domain issuer, including '/'.
AUTH0_ISSUER=https://your-tenant.eu.auth0.com/
# Auth0 Custom API identifier; never a Native/SPA client ID.
AUTH0_AUDIENCE=https://api.premiumpass.example

# Local DynamoDB; omit DYNAMODB_ENDPOINT to use AWS with its normal credential chain.
DYNAMODB_TABLE_NAME=premiumpass-local
DYNAMODB_ENDPOINT=http://127.0.0.1:8000

# Local web checkout (no trailing slash). Leave Stripe values unset until ready.
WEB_ORIGIN=http://localhost:5173
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_PRICE_ID=price_replace_me

# Local Apple purchase synchronization; no private key in the BFF.
APPLE_ENABLED=false
APPLE_PRODUCT_ID=premiumpass.premium.monthly.v2
SUBSCRIPTION_QUEUE_URL=http://127.0.0.1:9324/000000000000/premiumpass-subscriptions

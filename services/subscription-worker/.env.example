LOG_LEVEL=info
DYNAMODB_TABLE_NAME=premiumpass-local
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
SUBSCRIPTION_QUEUE_URL=http://127.0.0.1:9324/000000000000/premiumpass-subscriptions
# Use the same Stripe test environment and price as services/api/.env.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME

# Apple App Store sandbox. This is the ONLY service that needs the .p8 key.
APPLE_ENABLED=false
APPLE_BUNDLE_ID=com.example.premiumpass
APPLE_PRODUCT_ID=premiumpass.premium.monthly.v2
APPLE_IAP_KEY_ID=YOUR_KEY_ID
APPLE_IAP_ISSUER_ID=YOUR_ISSUER_UUID
# Absolute path, quoted when it contains spaces. Never EXPO_PUBLIC_*.
APPLE_IAP_PRIVATE_KEY_PATH=/absolute/path/SubscriptionKey_YOUR_KEY_ID.p8

# Google Play license-test purchases only; keep disabled until Console setup.
GOOGLE_PLAY_ENABLED=false
# GOOGLE_PLAY_PACKAGE_NAME=com.yourcompany.premiumpass
# GOOGLE_PLAY_PRODUCT_ID=premium_monthly
# GOOGLE_PLAY_BASE_PLAN_ID=monthly
# Backend only: absolute path to your dedicated service-account JSON key.
# GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/absolute/private/path/google.service-account.json

{
  "name": "@premiumpass/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include \"../../packages/*/src/**/*.ts\" --env-file-if-exists=.env src/local.ts",
    "start": "node --env-file-if-exists=.env dist/local.js",
    "db:init": "tsx scripts/init-local-db.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/local.ts src/lambda.ts --bundle --platform=node --target=node24 --format=esm --outdir=dist --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1149.0",
    "@aws-sdk/lib-dynamodb": "3.1149.0",
    "@hono/aws-lambda": "1.0.1",
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "stripe": "23.0.0",
    "zod": "4.6.5",
    "@premiumpass/domain": "workspace:*",
    "@premiumpass/persistence": "workspace:*",
    "@premiumpass/logging": "workspace:*",
    "@premiumpass/billing-contracts": "workspace:*",
    "@aws-sdk/client-sqs": "3.1149.0",
    "@premiumpass/api-contracts": "workspace:*",
    "@premiumpass/aws-clients": "workspace:*",
    "@premiumpass/google-play": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.159",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
